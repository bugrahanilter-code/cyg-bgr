# ===========================================================================
#  Crypto Algorithmic Trading Platform — environment example
# ===========================================================================
#  1. Copy this file to ".env"          ->  cp .env.example .env
#  2. Fill in ONLY what you need.
#  3. NEVER commit the real ".env" file (it is already in .gitignore).
#
#  All secret values below are intentionally EMPTY.
# ===========================================================================

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
APP_ENV=development
# Used to encrypt API secrets that are stored in the database.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
LOG_LEVEL=INFO
LOG_JSON=true
# Comma separated list of origins allowed to call the backend API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Database (PostgreSQL runs inside docker compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=trader
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=trading
# Default: SQLite, a single file under backend/data. Nothing to install and it
# works on any machine. This is what scripts/start-backend.bat uses.
DATABASE_URL=sqlite+pysqlite:///./data/dev.db

# Using docker compose instead? It sets DATABASE_URL itself, so you do not need
# to change anything here. To point a LOCAL backend at a PostgreSQL you are
# running yourself, comment the line above and use this one, with "localhost"
# rather than "db" - "db" only resolves inside the compose network:
# DATABASE_URL=postgresql+psycopg2://trader:change_this_password@localhost:5432/trading

# ---------------------------------------------------------------------------
# Binance API  — LEAVE EMPTY UNTIL YOU REALLY NEED IT
# ---------------------------------------------------------------------------
#  * Market data (backtest / paper trading) works WITHOUT any API key.
#  * When you create a key on Binance:
#       - ENABLE  : "Enable Reading"
#       - ENABLE  : "Enable Futures" (only if you want futures trading)
#       - DISABLE : "Enable Withdrawals"   <-- MUST STAY OFF
#       - Restrict access to your own IP address.
#  * The secret is never sent to the frontend and never written to logs.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Use Binance testnet endpoints (recommended for the first live-trading test).
BINANCE_TESTNET=false
# spot | futures
BINANCE_MARKET_TYPE=futures
BINANCE_RECV_WINDOW=5000

# ---------------------------------------------------------------------------
# Trading mode
# ---------------------------------------------------------------------------
# backtest | paper | live   (live also requires LIVE_TRADING_ENABLED=true
# AND an explicit confirmation from the dashboard)
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
ENABLED_SYMBOLS=BTC/USDT,ETH/USDT
DEFAULT_TIMEFRAME=15m
HIGHER_TIMEFRAME=4h
PAPER_STARTING_BALANCE=10000

# ---------------------------------------------------------------------------
# Conservative default risk settings (editable later from the dashboard)
# ---------------------------------------------------------------------------
RISK_PER_TRADE_PCT=0.5
DAILY_PROFIT_TARGET_PCT=2.0
DAILY_LOSS_LIMIT_PCT=1.5
MAX_CONCURRENT_POSITIONS=2
MAX_TRADES_PER_DAY=15
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=30
MAX_DRAWDOWN_PCT=15.0
MAX_LEVERAGE=3
MAX_POSITION_NOTIONAL_PCT=100.0
MAX_TOTAL_EXPOSURE_PCT=200.0

# ---------------------------------------------------------------------------
# Cost model used by backtest / paper trading
# ---------------------------------------------------------------------------
TAKER_FEE_PCT=0.04
MAKER_FEE_PCT=0.02
SLIPPAGE_PCT=0.02
FUNDING_RATE_PCT_PER_8H=0.01

# ---------------------------------------------------------------------------
# Frontend (read at build time by Vite)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api
